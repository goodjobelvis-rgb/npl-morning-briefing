# .env에 아래 이름 그대로 값을 채워 넣으세요. (이 파일에는 값을 넣지 마세요)

# AI 요약용 (https://platform.openai.com 에서 발급)
OPENAI_API_KEY=
# 선택: 쓰고 싶은 모델 이름 (비워 두면 gpt-5.5)
OPENAI_MODEL=

# 브리핑 API를 호출할 때 쓰는 비밀 토큰 (아무도 모르는 긴 임의 문자열)
CRON_SECRET=

# 메일 발송용 (Gmail)
# MAIL_USER: 보내는 Gmail 주소
# MAIL_APP_PASSWORD: 구글 계정의 "앱 비밀번호" 16자리 (로그인 비밀번호가 아님)
# MAIL_TO: 브리핑을 받을 주소 (보내는 주소와 같아도 됨)
MAIL_USER=
MAIL_APP_PASSWORD=
MAIL_TO=
